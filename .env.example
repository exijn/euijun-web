# 모두 서버 전용입니다. VITE_ 접두사를 붙이지 마세요.
# 사이트의 HTTPS origin. 로컬 개발만 http://localhost:4174 사용 가능.
APP_ORIGIN=
# GitHub OAuth App Client ID 및 Client secret. callback: APP_ORIGIN/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# gh api users/exijn --jq .id 로 확인한 숫자 ID. login exijn도 서버에서 함께 검사.
GITHUB_OWNER_ID=
# exijn/저장소이름. 기본 브랜치는 GitHub API에서 읽습니다.
GITHUB_REPOSITORY=
# 해당 저장소 전용 fine-grained PAT. Contents·Pull requests: write, Deployments: read.
GITHUB_CONTENT_TOKEN=
# 암호학적 난수 32바이트를 base64로 인코딩한 값. 생성 명령은 docs/admin-setup.md 참고.
SESSION_SECRET=
# 선택: 독립 Node 서버 포트/바인딩. 기본 4174, 127.0.0.1.
PORT=
HOST=
